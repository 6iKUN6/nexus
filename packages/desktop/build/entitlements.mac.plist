<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <!-- Standard Electron hardened-runtime entitlements; referenced by
       electron-builder.yml only when signing is enabled (docs/distribution.md).
       Nexus needs JIT (V8) and unsigned memory (V8 builtins); it never uses
       camera/mic/location, so those stay absent. -->
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
  </dict>
</plist>
