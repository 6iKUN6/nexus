{
  "name": "nexus",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @nexus/desktop dev",
    "build": "pnpm --filter @nexus/desktop build",
    "pack:mac": "pnpm --filter @nexus/desktop pack:dir",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r --parallel typecheck && tsc -p scripts/tsconfig.json",
    "deps:check": "depcruise packages --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm deps:check && pnpm test",
    "probe": "pnpm --filter @nexus/probes probe",
    "probe:report": "pnpm --filter @nexus/probes report",
    "brand": "node scripts/brand.ts",
    "test:contract": "NEXUS_CONTRACT=1 vitest run",
    "e2e:smoke": "scripts/e2e/smoke.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "^24.0.0",
    "dependency-cruiser": "^18.7.2",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
